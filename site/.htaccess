RewriteEngine On

# Preservar a validação do certificado SSL
RewriteRule ^\.well-known/ - [L]

# Redirecionar www para o domínio principal, já em HTTPS
RewriteCond %{HTTP_HOST} ^www\.maf3tech\.com\.br$ [NC]
RewriteRule ^ https://maf3tech.com.br%{REQUEST_URI} [L,R=301]

# Forçar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Página de erro 404
ErrorDocument 404 /404.html
